{
  "name": "asso",
  "version": "1.0.0",
  "scripts": {
    "ng": "node scripts/angular-cli.cjs",
    "start": "node scripts/angular-cli.cjs serve --serve-path /",
    "start:helloasso": "node scripts/angular-cli.cjs serve --serve-path / --configuration=helloasso-local --ssl --proxy-config proxy.helloasso-local.json",
    "build": "node scripts/angular-cli.cjs build",
    "build:production": "node scripts/angular-cli.cjs build --base-href / --configuration=production",
    "build:integration": "node scripts/angular-cli.cjs build --base-href / --configuration=integration",
    "watch": "node scripts/angular-cli.cjs build --watch --configuration development",
    "test": "node scripts/angular-cli.cjs test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.1.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "@wfpena/angular-wysiwyg": "^2.0.1",
    "angular-file": "^4.0.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.3.0",
    "ngx-extended-pdf-viewer": "^29.0.1",
    "ngx-image-cropper": "9.1.7",
    "rxjs": "^7.8.0",
    "tslib": "^2.1.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^26.5.1",
    "jasmine-core": "^5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~6.0.3"
  }
}
