{
  "request": {
    "method": "POST",
    "urlPath": "/oauth2/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "bodyPatterns": [
      {
        "contains": "grant_type=client_credentials"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "local-wiremock-token",
      "refresh_token": "local-wiremock-refresh-token",
      "expires_in": 3600
    }
  }
}
