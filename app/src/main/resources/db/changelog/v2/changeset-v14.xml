<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="v14-adhesion-reconciliation" author="adhesion">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><columnExists tableName="adhesions" columnName="rapprochement"/></not>
    </preConditions>
    <addColumn tableName="adhesions">
      <column name="rapprochement" type="boolean" defaultValueBoolean="false"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
