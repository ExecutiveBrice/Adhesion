<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="v14-adhesion-rapprochement" author="adhesion">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><columnExists tableName="adhesions" columnName="rapprochement"/></not>
    </preConditions>
    <addColumn tableName="adhesions"><column name="rapprochement" type="boolean"/></addColumn>
  </changeSet>
  <changeSet id="v14-newsletter-campaign-id" author="adhesion">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><columnExists tableName="historique" columnName="campaign_id"/></not>
    </preConditions>
    <addColumn tableName="historique"><column name="campaign_id" type="bigint"/></addColumn>
  </changeSet>
  <changeSet id="v14-newsletter-campaign-status" author="adhesion">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><columnExists tableName="historique" columnName="campaign_status"/></not>
    </preConditions>
    <addColumn tableName="historique"><column name="campaign_status" type="varchar(255)"/></addColumn>
  </changeSet>
  <changeSet id="v14-newsletter-brevo-status" author="adhesion">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><columnExists tableName="historique" columnName="brevo_status"/></not>
    </preConditions>
    <addColumn tableName="historique"><column name="brevo_status" type="varchar(255)"/></addColumn>
  </changeSet>
  <changeSet id="v14-newsletter-campaign-unique" author="adhesion">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><indexExists tableName="historique" indexName="historique_campaign_id_unique"/></not>
    </preConditions>
    <createIndex tableName="historique" indexName="historique_campaign_id_unique" unique="true">
      <column name="campaign_id"/>
    </createIndex>
  </changeSet>
  <changeSet id="v14-logistique-role" author="adhesion">
    <sql>ALTER TABLE user_role_names DROP CONSTRAINT IF EXISTS user_role_names_v2_role_name_check</sql>
    <sql>ALTER TABLE user_role_names DROP CONSTRAINT IF EXISTS user_role_names_erole_check</sql>
    <sql>ALTER TABLE user_role_names ADD CONSTRAINT user_role_names_v2_role_name_check CHECK (role_name IN (
      'ROLE_USER', 'ROLE_SECRETAIRE', 'ROLE_BUREAU', 'ROLE_MEMBRECA', 'ROLE_ADMIN',
      'ROLE_COMPTABLE', 'ROLE_ENCADRANT', 'ROLE_COMMUNICATION_GLOBAL',
      'ROLE_RESPONSABLE_BOUTIQUE', 'ROLE_REFERENT', 'ROLE_LOGISTIQUE'))</sql>
  </changeSet>
</databaseChangeLog>
