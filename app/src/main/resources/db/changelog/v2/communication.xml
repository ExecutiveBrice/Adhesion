<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="v2-communication" author="adhesion">
    <preConditions onFail="HALT" onError="HALT">
      <not><tableExists tableName="publicites"/></not>
    </preConditions>
    <comment>Communication module after production commit 8a2cb143.</comment>
    <createTable tableName="publicites">
      <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="description" type="varchar(200)"><constraints nullable="false"/></column>
      <column name="content_type" type="varchar(30)"><constraints nullable="false"/></column>
      <column name="image" type="bytea"><constraints nullable="false"/></column>
    </createTable>
  </changeSet>
</databaseChangeLog>
