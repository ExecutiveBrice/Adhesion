<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="v8-responsabilites-seance" author="codex">
    <createTable tableName="taches_seance">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="nom" type="VARCHAR(100)"><constraints nullable="false" unique="true"/></column>
    </createTable>
    <createTable tableName="responsabilites_seance">
      <column name="seance_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="position" type="INTEGER"><constraints nullable="false"/></column>
      <column name="tache_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="adherent_id" type="BIGINT"><constraints nullable="false"/></column>
    </createTable>
    <addPrimaryKey tableName="responsabilites_seance" columnNames="seance_id,position" constraintName="pk_responsabilites_seance"/>
    <addForeignKeyConstraint baseTableName="responsabilites_seance" baseColumnNames="seance_id" referencedTableName="seance" referencedColumnNames="id" constraintName="fk_responsabilites_seance" onDelete="CASCADE"/>
    <addForeignKeyConstraint baseTableName="responsabilites_seance" baseColumnNames="tache_id" referencedTableName="taches_seance" referencedColumnNames="id" constraintName="fk_responsabilites_tache"/>
    <addForeignKeyConstraint baseTableName="responsabilites_seance" baseColumnNames="adherent_id" referencedTableName="adherents" referencedColumnNames="id" constraintName="fk_responsabilites_adherent"/>
    <createIndex tableName="responsabilites_seance" indexName="idx_responsabilites_tache"><column name="tache_id"/></createIndex>
    <createIndex tableName="responsabilites_seance" indexName="idx_responsabilites_adherent"><column name="adherent_id"/></createIndex>
  </changeSet>
</databaseChangeLog>
