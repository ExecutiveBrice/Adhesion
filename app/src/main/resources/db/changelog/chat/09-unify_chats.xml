<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="unify-chats-09" author="adhesion">
    <comment>Unify managed chats, preserving their messages, permissions and read cursors.</comment>
    <renameTable oldTableName="section_chats" newTableName="chats"/>
    <renameTable oldTableName="section_chat_permissions" newTableName="chat_permissions"/>
    <renameColumn tableName="chat_permissions" oldColumnName="section_chat_id" newColumnName="chat_id" columnDataType="bigint"/>
    <renameTable oldTableName="section_chat_reads" newTableName="chat_reads"/>
    <renameColumn tableName="chat_reads" oldColumnName="section_chat_id" newColumnName="chat_id" columnDataType="bigint"/>
    <renameTable oldTableName="activity_chat_messages" newTableName="chat_messages"/>
    <renameColumn tableName="chat_messages" oldColumnName="section_chat_id" newColumnName="chat_id" columnDataType="bigint"/>
    <sql>ALTER TABLE chat_messages DROP CONSTRAINT ck_activity_chat_channel</sql>
    <dropIndex tableName="chat_messages" indexName="idx_activity_chat_activity_id"/>
    <dropIndex tableName="chat_messages" indexName="idx_activity_chat_channel_id"/>
    <dropColumn tableName="chat_messages" columnName="activite_id"/>
    <dropColumn tableName="chat_messages" columnName="channel"/>
    <addNotNullConstraint tableName="chat_messages" columnName="chat_id" columnDataType="bigint"/>
    <dropTable tableName="activity_chat_reads"/>
    <dropTable tableName="communication_chat_reads"/>
    <dropTable tableName="referent_encadrant_chat_reads"/>
    <sql><![CDATA[
      CREATE TABLE section_referents (
        section_id bigint NOT NULL REFERENCES sections(id) ON DELETE CASCADE,
        user_id bigint NOT NULL REFERENCES users(id) ON DELETE CASCADE,
        PRIMARY KEY (section_id, user_id)
      );
    ]]></sql>
  </changeSet>
</databaseChangeLog>
