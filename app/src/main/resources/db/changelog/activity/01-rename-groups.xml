<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="activity-01-rename-groups" author="adhesion">
    <update tableName="activites">
      <column name="groupe" value="NON_COMPETITIVE"/>
      <where>groupe = 'ALOD_G'</where>
    </update>
    <update tableName="activites">
      <column name="groupe" value="COMPETITION"/>
      <where>groupe = 'ALOD_B'</where>
    </update>
    <update tableName="activites_nm1">
      <column name="groupe" value="NON_COMPETITIVE"/>
      <where>groupe = 'ALOD_G'</where>
    </update>
    <update tableName="activites_nm1">
      <column name="groupe" value="COMPETITION"/>
      <where>groupe = 'ALOD_B'</where>
    </update>
    <rollback>
      <update tableName="activites">
        <column name="groupe" value="ALOD_G"/>
        <where>groupe = 'NON_COMPETITIVE'</where>
      </update>
      <update tableName="activites">
        <column name="groupe" value="ALOD_B"/>
        <where>groupe = 'COMPETITION'</where>
      </update>
      <update tableName="activites_nm1">
        <column name="groupe" value="ALOD_G"/>
        <where>groupe = 'NON_COMPETITIVE'</where>
      </update>
      <update tableName="activites_nm1">
        <column name="groupe" value="ALOD_B"/>
        <where>groupe = 'COMPETITION'</where>
      </update>
    </rollback>
  </changeSet>
</databaseChangeLog>
